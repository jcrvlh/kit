# ─────────────────────────────────────────────────────────────
# Sistema operacional / editor
# ─────────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
.idea/
# .vscode/ é versionado (só settings.json compartilhado); ignore local overrides:
.vscode/settings.local.json
.vscode/*.log

# ─────────────────────────────────────────────────────────────
# ESP-IDF / firmware (artefatos de build — regeneráveis)
# ─────────────────────────────────────────────────────────────
build/
managed_components/
.cache/
sdkconfig
sdkconfig.old
sdkconfig.defaults.old
*.bak

# Binários flasháveis gerados — distribuídos via GitHub Releases, não no repo
firmware/bin/

# Mantidos no repo (não ignorar):
#   firmware/sdkconfig.defaults
#   firmware/dependencies.lock
#   firmware/partitions.csv
#   **/idf_component.yml

# ─────────────────────────────────────────────────────────────
# Python / kit-cli
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.pytest_cache/
.tox/
.venv/
venv/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────
# Tools SDK — saídas de empacotamento (regeneráveis via kit-cli)
# ─────────────────────────────────────────────────────────────
*.kit
tools-sdk/examples/**/tool.elf
tools-sdk/examples/**/build/

# ─────────────────────────────────────────────────────────────
# Rascunhos / trabalho local
# ─────────────────────────────────────────────────────────────
/scratchpad/

# ─────────────────────────────────────────────────────────────
# Material interno — racionínio de projeto e notas de bring-up.
# Fica na cópia local, fora do repo público.
# ─────────────────────────────────────────────────────────────
/docs/decisions/
/ROADMAP.md
/HARDWARE_STATUS.md
/CHANGELOG.internal.md

# Design system + brand brief compilados (HTML/PDF) — peças internas de marca.
# O documento vivo público é docs/design/design-language.md.
/docs/design/design-system.html
/docs/design/design-system.pdf
/docs/design/brand-brief.html
/docs/design/brand-brief.pdf

# Manual do usuário compilado (HTML/PDF) — peça interna.
/docs/manual/manual-do-usuario.html
/docs/manual/manual-do-usuario.pdf

# Screenshots/mockups de divulgação (gerados a partir do firmware) + fontes
# baixadas p/ o render. Peça de marca — fora do repo público.
/docs/marketing/

# Skills do Claude Code (workflows internos: nova-tool, flash-hw, bump-firmware,
# publica-tool, design-bauhaus, marketing-assets). Ferramental local, fora do repo.
/.claude/skills/

# Docs de Tools do catálogo (vivem em kit-tools, não built-in no Core) — notas
# locais, fora do repo público.
/docs/tools/veto.md
/docs/tools/testa.md
/docs/tools/pavio.md
/docs/tools/adedonha.md
/docs/tools/repete.md
/docs/tools/quebragelo.md
/docs/tools/mimica.md

# Binários de teste nativo dos exemplos (regeneráveis via cmake/kit-cli)
tools-sdk/examples/*/test_*
!tools-sdk/examples/*/test_*.c
!tools-sdk/examples/*/test_*.h
